<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
    <moduleName>Ehlnofey</moduleName>
    <requiredInstallFiles>
        <file source="Ehlnofey.esp" destination="Ehlnofey.esp"/>
    </requiredInstallFiles>
    <!-- The installSteps block is deliberate even though there is nothing to choose: CLAUDE.md's
         FOMOD gotcha records that a config with only <requiredInstallFiles> gives MO2 no wizard page
         to draw an installer banner on. Keeping the block means adding <moduleImage>/<image> later
         is a two-line change rather than a restructure. See build/staging/Example Mod/fomod/ for the
         confirmed-working image recipe (archive-root-relative path INCLUDING the fomod prefix,
         backslashes, baseline JPEG). -->
    <installSteps order="Explicit">
        <installStep name="Options">
            <optionalFileGroups order="Explicit">
                <group name="Installation" type="SelectExactlyOne">
                    <plugins order="Explicit">
                        <plugin name="Ehlnofey">
                            <description>A deleveling overhaul. Enemies, dungeons and loot have fixed, hand-set levels; nothing recalculates against your level. Requires Dawnguard and Dragonborn.</description>
                            <typeDescriptor>
                                <type name="Recommended"/>
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
            </optionalFileGroups>
        </installStep>
    </installSteps>
</config>
